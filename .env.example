# Firebase Web App Configuration (Firebase Console -> Project Settings -> Your Apps)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=1:your_sender_id:web:your_app_id

# Firebase App Check (ReCaptchaV3 site key + Debug Token for unpacked MV3 extensions)
VITE_FIREBASE_RECAPTCHA_SITE_KEY=your_recaptcha_v3_site_key
# Set to "true" to auto-generate & log a debug token in Side Panel DevTools console,
# or set to your registered Firebase App Check debug token UUID.
VITE_APPCHECK_DEBUG_TOKEN=true

# Optional: Override default cloud Gemini model (defaults to gemini-3.8-flash)
# VITE_FIREBASE_CLOUD_MODEL=gemini-3.8-flash
